{
  "name": "intuit-cursor-301",
  "version": "1.0.0",
  "private": true,
  "description": "TurboTax Expert Ops — demo console for the Intuit × Cursor 301 session. Synthetic filers only.",
  "repository": {
    "type": "git",
    "url": "https://github.com/davidgeorgehope/intuit-cursor-301.git"
  },
  "scripts": {
    "dev": "next dev --port 43173",
    "build": "next build",
    "start": "next start --port 43173",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit --pretty false",
    "check": "npm run typecheck && npm run lint && npm test",
    "test": "vitest run",
    "verify": "tsx scripts/verify-expert-ops.ts",
    "eval:skills": "tsx scripts/eval-skills.ts",
    "eval:trigger": "tsx scripts/eval-trigger.ts",
    "harness:mission": "tsx scripts/harness-mission.ts",
    "harness:compare": "tsx scripts/harness-compare.ts",
    "mission:plant": "tsx scripts/mission-plant.ts",
    "mission:restore": "tsx scripts/mission-plant.ts --restore",
    "mission:arm": "tsx scripts/mission-arm.ts",
    "mission:disarm": "tsx scripts/mission-arm.ts --disarm",
    "hooks:smoke": "node scripts/hooks-smoke.mjs",
    "test:watch": "vitest",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:reset": "prisma db push --force-reset && prisma db seed",
    "demo:session": "tsx scripts/demo-reset.ts",
    "demo:reset": "tsx scripts/demo-reset.ts reset",
    "setup": "npm ci && prisma generate && prisma db push && prisma db seed",
    "harness:ready-vs-bare": "tsx scripts/harness-ready-vs-bare.ts",
    "sdk:readonly": "tsx scripts/sdk/readonly-cost.ts",
    "sdk:steer": "tsx scripts/sdk/steer.ts",
    "sdk:mission": "tsx scripts/sdk/mission-runner.ts",
    "hooks:exec-probe": "node scripts/hooks-exec-probe.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^6.19.2",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "better-sqlite3": "^11.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@cursor/sdk": "^1.0.40",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=22.13"
  }
}
