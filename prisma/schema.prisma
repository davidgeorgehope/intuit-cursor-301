generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Workspace {
  id        String         @id
  name      String
  slug      String         @unique
  createdAt DateTime       @default(now())
  filers    Filer[]
  returns   TaxReturn[]
  reviews   CreditReview[]
}

model Filer {
  id           String      @id
  workspaceId  String
  workspace    Workspace   @relation(fields: [workspaceId], references: [id])
  name         String
  email        String
  filingStatus String
  /// Only the last four digits are stored. Full SSNs never enter this database.
  ssnLast4     String
  state        String
  createdAt    DateTime    @default(now())
  returns      TaxReturn[]
}

model TaxReturn {
  id             String         @id
  number         String         @unique
  workspaceId    String
  workspace      Workspace      @relation(fields: [workspaceId], references: [id])
  filerId        String
  filer          Filer          @relation(fields: [filerId], references: [id])
  taxYear        Int
  status         String
  dueOn          DateTime
  extendedOn     DateTime?
  transmittedOn  DateTime?
  acceptedOn     DateTime?
  rejectedOn     DateTime?
  rejectCode     String?
  lastActivityOn DateTime
  /// Positive is a refund; negative is a balance due.
  refundCents    Int
  memo           String?
  forms          TaxForm[]
  reviews        CreditReview[]
}

model TaxForm {
  id            String    @id
  returnId      String
  taxReturn     TaxReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  formType      String
  issuer        String
  amountCents   Int
  withheldCents Int       @default(0)
}

model CreditReview {
  id                     String    @id
  returnId               String
  taxReturn              TaxReturn @relation(fields: [returnId], references: [id])
  workspaceId            String
  workspace              Workspace @relation(fields: [workspaceId], references: [id])
  credit                 String
  status                 String
  reason                 String
  openedOn               DateTime
  qualifiedExpensesCents Int
  claimedCents           Int
  allowedCreditCents     Int
  expertNote             String?
}
